{
  "name": "mcp-multi-gmail",
  "version": "1.5.1",
  "description": "MCP server pro přístup k víc gmailovým schránkám naráz přes IMAP",
  "license": "Apache-2.0",
  "author": "Karel Derfl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reditelai/mcp-multi-gmail.git"
  },
  "homepage": "https://github.com/reditelai/mcp-multi-gmail#readme",
  "bugs": "https://github.com/reditelai/mcp-multi-gmail/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "imap",
    "email"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "mcp-multi-gmail": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "config.example.json",
    "config.example.advanced.json",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "imapflow": "^1.7.8",
    "nodemailer": "^10.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  }
}
